  "restraints": {
    "bonds": [
      {
        "name": "Cu-S_example_1",
        "atoms": [
          {"chain_id": "C", "residue_id": "1", "residue_name": "CU1", "atom_name": "CU"},
          {"chain_id": "A", "residue_id": "56", "residue_name": "CYS", "atom_name": "SG"}
        ],
        "r0_nm": 0.23,
        "k_kj_mol_nm2": 2500.0,
        "periodic": true
      },
      {
        "name": "Cu-S_example_2",
        "atoms": [
          {"chain_id": "C", "residue_id": "1", "residue_name": "CU1", "atom_name": "CU"},
          {"chain_id": "A", "residue_id": "63", "residue_name": "CYS", "atom_name": "SG"}
        ],
        "r0_nm": 0.23,
        "k_kj_mol_nm2": 2500.0,
        "periodic": true
      }
    ],
    "angles": [
      {
        "name": "S-Cu-S_example",
        "atoms": [
          {"chain_id": "A", "residue_id": "56", "residue_name": "CYS", "atom_name": "SG"},
          {"chain_id": "C", "residue_id": "1", "residue_name": "CU1", "atom_name": "CU"},
          {"chain_id": "A", "residue_id": "63", "residue_name": "CYS", "atom_name": "SG"}
        ],
        "theta0_degrees": 120.0,
        "k_kj_mol_rad2": 200.0,
        "periodic": true
      }
    ],
    "torsions": []
