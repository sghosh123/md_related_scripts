    "constraints": "HBonds",
    "rigid_water": true,
    "remove_center_of_mass_motion": true,
    "ewald_error_tolerance": 0.0005,
    "pressure_bar": null,
    "barostat_frequency_steps": 25,
    "platform": "CPU",
    "platform_properties": {},
    "random_seed": 20261011,
    "trajectory_interval_steps": 5000,
    "log_interval_steps": 1000,
    "checkpoint_interval_steps": 10000
