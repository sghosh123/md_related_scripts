{
  "schema_version": 1,
  "template_status": "template",
  "metadata": {
    "model_system": "SET_THIS_TO_YOUR_SYSTEM",
    "description": "Generalized example informed by historical copper-restraint workflows. Numeric targets and selectors below are illustrative only, not validated parameters for a specific protein.",
    "source_basis": "Reviewed legacy 1FD8/1TL4 OpenMM scripts; see docs/simulation-setups-audit.md"
  },
  "inputs": {
    "pdb": "../../inputs/CHANGE_ME_system.pdb",
